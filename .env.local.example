# ─── Smarthome — Constructora Anaya Giraldo S.A.S ───────────────────────────
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio. Estas claves son secretas y solo
# se usan en el servidor (nunca con prefijo NEXT_PUBLIC_).

# API REST v1 (inventario, proyectos, clientes, leads, posventa)
SMARTHOME_API_BASE=https://api.smart-home.com.co
SMARTHOME_COMPANY_CODE=1059512

# API Key por proyecto (necesaria para escrituras: addCustomer/addClaim).
# Se genera en el portal: Integraciones API > API Key Smarthome.
SMARTHOME_API_KEY=

# API BI (reportería). La userKey EXPIRA — regenérala en el portal cuando caduque.
SMARTHOME_BI_BASE=https://manage.smart-home.com.co
SMARTHOME_BI_USERKEY=ZTIwNDcwMzUtNzkzNi00NTY5LWJjMzYtMTY5NWYwZjk3Y2NkO2ZmNmJjMzg0LTA4NWMtNGU3OS1iMjhlLWM1OWE5ZGJhMGZiZDs2LzI3LzIwMjY=

# ─── Supabase (cartera, estados de gestión y bitácora en tiempo real) ────────
# Crea un proyecto en https://supabase.com y corre supabase/schema.sql en el SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # clave pública (anon) — para el cliente/realtime
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # clave service_role — SOLO servidor (sync/cron)

# Token para proteger el endpoint de sincronización (cron). Inventa una cadena larga.
CARTERA_SYNC_SECRET=cambia-esto-por-un-secreto-largo
